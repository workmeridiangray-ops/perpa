NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # from `npx supabase status`

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=                    # 24+ random chars; scheduler calls POST /api/jobs/run with it
EMAIL_API_URL=                  # HTTPS endpoint of your email provider (JSON: from,to,subject,text; Bearer auth)
EMAIL_API_KEY=
EMAIL_FROM=
PAYMENT_WEBHOOK_SECRET=         # HMAC secret shared with the payment provider callback
SCAN_WEBHOOK_SECRET=            # HMAC secret shared with the malware scanner callback
